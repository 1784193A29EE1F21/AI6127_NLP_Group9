# Copy this file to ".env" and fill in your key. NEVER put the key in the notebook / code.

# ---- Generator LLM: any OpenAI-compatible provider ------------------------
# Groq (free: 1K requests/day, 8K tokens/min, 200K tokens/day per model)
LLM_PROVIDER=openai
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=gsk_your_key
LLM_MODEL=openai/gpt-oss-120b
LLM_RPM=3

# DeepSeek (paid but very cheap, no daily limit) - recommended for the full evaluation
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-your_key
# LLM_MODEL=deepseek-chat
# LLM_RPM=0

# Google Gemini
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=your-key
# LLM_MODEL=gemini-2.5-flash

# ---- Optional: a DIFFERENT model as evaluation judge (06_eval_generation.py)
# avoids self-preference bias; on Groq each model has its own quota
# JUDGE_PROVIDER=openai
# JUDGE_BASE_URL=https://api.groq.com/openai/v1
# JUDGE_API_KEY=gsk_your_key
# JUDGE_MODEL=qwen/qwen3.8-27b

# ---- Retrieval models (defaults shown)
# EMBED_MODEL=intfloat/multilingual-e5-small
# RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# ---- Formal Q4/Q5 execution controls -----------------------------------
# MAX_CONCURRENT_REQUESTS=4
# MAX_RETRIES=3            # Maximum HTTP attempts per request
# REQUEST_TIMEOUT=120
# MAX_OUTPUT_TOKENS=4096   # Omitted by default; changing it freezes a new model-parameter contract
# MAX_COST_USD=10          # Requires all verified tariff fields below and MAX_OUTPUT_TOKENS
# INPUT_PRICE_PER_MTOK=    # Actual supplier input price per million tokens
# OUTPUT_PRICE_PER_MTOK=   # Actual supplier output price per million tokens
# API_PRICE_SOURCE=       # Verifiable tariff source/date; unknown pricing never becomes a guessed dollar cost
